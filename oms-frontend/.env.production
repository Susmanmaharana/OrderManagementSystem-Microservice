# Used by CRA production build when not overridden by Docker build-args.
# Docker Compose overrides these to /backend/* (Nginx proxy) — see docker-compose.yml.
#
# Host port map (your running stack):
#   gateway  18080 → 8080
#   order    8081  → 8081
#   inventory 8082 → 8082
#   payment  8083  → 8083
#   notification 8084 → 8084
REACT_APP_ORDER_SERVICE_URL=http://localhost:8081
REACT_APP_INVENTORY_SERVICE_URL=http://localhost:8082
REACT_APP_PAYMENT_SERVICE_URL=http://localhost:8083
REACT_APP_NOTIFICATION_SERVICE_URL=http://localhost:8084
REACT_APP_GATEWAY_URL=http://localhost:18080
