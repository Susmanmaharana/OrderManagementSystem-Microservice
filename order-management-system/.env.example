# Local / Docker env template — copy to .env (do not commit secrets)

POSTGRES_USER=oms
POSTGRES_PASSWORD=oms_secret_change_me

# Host-side JDBC (apps on host talking to compose Postgres). Inside compose, URLs use host "postgres".
ORDER_DB_URL=jdbc:postgresql://localhost:5432/order_db
INVENTORY_DB_URL=jdbc:postgresql://localhost:5432/inventory_db
PAYMENT_DB_URL=jdbc:postgresql://localhost:5432/payment_db
NOTIFICATION_DB_URL=jdbc:postgresql://localhost:5432/notification_db
DB_USERNAME=oms
DB_PASSWORD=oms_secret_change_me
DB_DRIVER=org.postgresql.Driver

# Host apps → localhost:9092; containers → kafka:29092 (set in docker-compose.yml)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=true

JWT_SECRET=change-me-to-a-long-random-secret-key-32bytes
JWT_EXPIRATION_MS=3600000

PAYMENT_FAILURE_RATE=0.0
PAYMENT_DELAY_MS=0

# Host port for api-gateway (change if 8080 is already in use)
GATEWAY_HOST_PORT=8080
